# Build-time variables for the React site. In CI they come from GitHub secrets (see
# .github/workflows/deploy.yml); for a manual build, copy to frontend/.env.production.local.
# They are baked into the public JavaScript, so never put a real secret here.

VITE_API_URL=https://api.fayerahammed.com/api/v1
VITE_SITE_URL=https://fayerahammed.com
# Public "site key" of the Cloudflare Turnstile widget (the secret key goes in the backend .env).
VITE_TURNSTILE_SITE_KEY=
