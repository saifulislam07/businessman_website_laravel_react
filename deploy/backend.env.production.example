# Production .env for /var/www/fayerahammed/backend/.env  (never commit the real file)
# Copy this file, then fill in every value marked CHANGE. Checklist at the bottom.

APP_NAME="Fayer Ahammed"
APP_ENV=production
APP_KEY=                       # CHANGE: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://api.fayerahammed.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Frontend / CORS ---------------------------------------------------------
# The only origin allowed to call the API from a browser (config/cors.php).
FRONTEND_URL=https://fayerahammed.com

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fayer_ahammed
DB_USERNAME=fayer_app          # CHANGE: dedicated MySQL user, not root
DB_PASSWORD=                   # CHANGE: long random password

# --- Cache, queue, sessions --------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# The admin panel and the API live on the API host. Use ".fayerahammed.com" only if cookies must
# be shared with the main site; the default (empty) keeps them on api.fayerahammed.com.
SESSION_DOMAIN=null
# Sanctum is installed but unused by the public site; keep stateful domains minimal.
SANCTUM_STATEFUL_DOMAINS=api.fayerahammed.com

# --- Mail (contact form notifications and auto-replies) ----------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                     # CHANGE: e.g. smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=                 # CHANGE
MAIL_PASSWORD=                 # CHANGE
MAIL_FROM_ADDRESS="hello@fayerahammed.com"
MAIL_FROM_NAME="Office of Fayer Ahammed"

# Receives new-message alerts and backup failure alerts.
ADMIN_NOTIFY_EMAIL=            # CHANGE

# --- Admin account (used once by: php artisan db:seed --class=AdminUserSeeder) -
ADMIN_EMAIL=                   # CHANGE
ADMIN_PASSWORD=                # CHANGE: long and unique; remove from .env after seeding

# --- Cloudflare Turnstile (contact form bot protection) ----------------------
# Without a secret in production, the contact form rejects every submission.
TURNSTILE_SECRET=              # CHANGE: secret key of the Turnstile widget

# --- Backups -----------------------------------------------------------------
# Leave unset on Linux: mysqldump is found on PATH (package mysql-client / mysql-server).
# DB_DUMP_PATH=

BCRYPT_ROUNDS=12

# ============================== PRODUCTION CHECKLIST ==============================
# [ ] APP_ENV=production and APP_DEBUG=false (debug pages leak secrets)
# [ ] APP_KEY generated once; back it up, losing it invalidates encrypted data and sessions
# [ ] APP_URL is https://api.fayerahammed.com (uploaded image URLs are built from it)
# [ ] FRONTEND_URL is exactly https://fayerahammed.com (no trailing slash): CORS allows only this
# [ ] Dedicated MySQL user with access to this database only
# [ ] SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true
# [ ] Real SMTP credentials; send a test message from the site and confirm both emails arrive
# [ ] TURNSTILE_SECRET set, and VITE_TURNSTILE_SITE_KEY set in the frontend build secrets
# [ ] ADMIN_PASSWORD changed from the demo value; consider removing it from .env after seeding
# [ ] storage/ and bootstrap/cache are writable by www-data; .env is mode 640, not world-readable
# [ ] php artisan config:cache was run after the last .env change (the deploy script does this)
